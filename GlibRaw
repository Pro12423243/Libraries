function Tab:AddToggle(text, valueId, default)
	local COLOR_ON = THEME.TogglePillColor or Color3.fromRGB(0, 170, 255)
	local COLOR_OFF = Color3.fromRGB(35, 35, 45)

	local STROKE_ON = THEME.ToggleStrokeColor or Color3.fromRGB(255, 255, 255)
	local STROKE_OFF = THEME.ComponentStrokeColor or Color3.fromRGB(60, 60, 70)

	local values = self.Window.Values
	if values[valueId] == nil then
		values[valueId] = default or false
	end

	self._componentCount = self._componentCount + 1
	local container = newComponentContainer(self.Page, "Toggle", 40, self._componentCount)

	local bar = newDarkCard(container)

	newGradientText(bar, {
		Name = "TextLabel",
		Size = UDim2.new(0.679, 0, 1, 0),
		Position = UDim2.new(0.34, 0, 0.5, 0),
		Text = text,
		TextSize = 16,
	})

	local toggleContain = create("Frame", {
		Name = "ToggleContain",
		Size = UDim2.new(0.267, 0, 0.829, 0),
		Position = UDim2.new(0.84, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = COLOR_OFF,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Parent = bar,
	})

	local toggleStroke = addPlainStroke(toggleContain, THEME.ComponentStrokeThickness, STROKE_OFF)
	addGradient(toggleContain, 0, THEME.TogglePillGradient)
	addCorner(toggleContain, UDim.new(0, 8))

	local stateLabel = newGradientText(toggleContain, { Text = "OFF", TextSize = 16 })

	local clickButton = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = bar,
	})

	local function refresh(animate)
		local on = values[valueId]
		stateLabel.Text = on and "ON" or "OFF"

		local targetBgColor = on and COLOR_ON or COLOR_OFF
		local targetStrokeColor = on and STROKE_ON or STROKE_OFF

		if animate then
			TweenService:Create(toggleContain, TWEEN_INFO, { BackgroundColor3 = targetBgColor }):Play()
			if toggleStroke then
				TweenService:Create(toggleStroke, TWEEN_INFO, { Color = targetStrokeColor }):Play()
			end
		else
			toggleContain.BackgroundColor3 = targetBgColor
			if toggleStroke then
				toggleStroke.Color = targetStrokeColor
			end
		end
	end

	refresh(false)

	clickButton.MouseButton1Click:Connect(function()
		sfxclick:Play()
		values[valueId] = not values[valueId]
		refresh(true)
	end)

	return container
end

function Tab:AddDropDownSingleSelect(text, options, valueId, default)
	local values = self.Window.Values
	options = options or {}
	if values[valueId] == nil then
		values[valueId] = default or options[1]
	end

	self._componentCount = self._componentCount + 1

	local container = create("Frame", {
		Name = "DropDown_" .. tostring(valueId),
		Size = UDim2.new(1, 0, 0, 40),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = self._componentCount,
		Parent = self.Page,
	})

	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = container,
	})

	local headerWrap = create("Frame", {
		Name = "HeaderWrap",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = container,
	})
	local header = newDarkCard(headerWrap)

	newGradientText(header, {
		Name = "Label",
		Size = UDim2.new(0.5, 0, 1, 0),
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Text = text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local valueLabel = newGradientText(header, {
		Name = "Value",
		Size = UDim2.new(0.35, 0, 1, 0),
		Position = UDim2.new(1, -36, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Text = tostring(values[valueId]),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local arrow = create("ImageLabel", {
		Name = "ArrowIcon",
		Size = UDim2.new(0, 16, 0, 16),
		Position = UDim2.new(1, -12, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Image = "rbxassetid://11552476728",
		ImageColor3 = Color3.fromRGB(200, 200, 200),
		Rotation = 0,
		Parent = header,
	})

	local clickButton = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = header,
	})

	local optionHeight = 32
	local optionPadding = 3
	local totalOptionsHeight = (#options * optionHeight) + (math.max(0, #options - 1) * optionPadding)

	local optionsList = create("CanvasGroup", {
		Name = "Options",
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		ClipsDescendants = true,
		Visible = false,
		LayoutOrder = 2,
		Parent = container,
	})

	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, optionPadding),
		Parent = optionsList,
	})

	local optionButtons = {}
	local isOpen = false

	local function refreshSelected()
		for optionValue, optCard in pairs(optionButtons) do
			local selected = (optionValue == values[valueId])
			local targetStroke = selected and Color3.fromRGB(255, 255, 255) or THEME.ComponentStrokeColor
			local targetTransparency = selected and 0.2 or 0.5

			TweenService:Create(optCard.UIStroke, TWEEN_INFO, { Color = targetStroke }):Play()
			TweenService:Create(optCard, TWEEN_INFO, { BackgroundTransparency = targetTransparency }):Play()
		end
		valueLabel.Text = tostring(values[valueId])
	end

	local function closeDropdown()
		isOpen = false
		TweenService:Create(arrow, TWEEN_INFO, { Rotation = 0 }):Play()
		TweenService:Create(optionsList, TWEEN_INFO, { Size = UDim2.new(1, 0, 0, 0), GroupTransparency = 1 }):Play()
		task.delay(0.3, function()
			if not isOpen then
				optionsList.Visible = false
			end
		end)
	end

	local function openDropdown()
		isOpen = true
		optionsList.Visible = true
		TweenService:Create(arrow, TWEEN_INFO, { Rotation = 180 }):Play()
		TweenService:Create(optionsList, TWEEN_INFO, { Size = UDim2.new(1, 0, 0, totalOptionsHeight), GroupTransparency = 0 }):Play()
	end

	for i, optionValue in ipairs(options) do
		local optWrap = create("Frame", {
			Name = "OptionWrap_" .. tostring(optionValue),
			Size = UDim2.new(1, 0, 0, optionHeight),
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Parent = optionsList,
		})

		local optCard = newDarkCard(optWrap)
		newGradientText(optCard, { 
			Text = tostring(optionValue), 
			TextSize = 14,
			Position = UDim2.new(0, 12, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			TextXAlignment = Enum.TextXAlignment.Left
		})

		optionButtons[optionValue] = optCard

		local optClick = create("TextButton", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 5,
			Parent = optCard,
		})

		optClick.MouseEnter:Connect(function()
			if values[valueId] ~= optionValue then
				TweenService:Create(optCard, TWEEN_INFO, { BackgroundTransparency = 0.3 }):Play()
			end
		end)

		optClick.MouseLeave:Connect(function()
			if values[valueId] ~= optionValue then
				TweenService:Create(optCard, TWEEN_INFO, { BackgroundTransparency = 0.5 }):Play()
			end
		end)

		optClick.MouseButton1Click:Connect(function()
			sfxclick:Play()
			values[valueId] = optionValue
			refreshSelected()
			closeDropdown()
		end)
	end

	refreshSelected()

	clickButton.MouseButton1Click:Connect(function()
		sfxclick:Play()
		if isOpen then
			closeDropdown()
		else
			openDropdown()
		end
	end)

	return container
end

function Tab:_buildInputBase(name, text, initialText, filterType)
	self._componentCount = self._componentCount + 1
	local container = newComponentContainer(self.Page, name, 40, self._componentCount)
	local bar = newDarkCard(container)

	newGradientText(bar, {
		Name = "TextLabel",
		Size = UDim2.new(0.679, 0, 1, 0),
		Position = UDim2.new(0.34, 0, 0.5, 0),
		Text = text,
		TextSize = 16,
	})

	local inputContain = create("Frame", {
		Name = "InputContain",
		Size = UDim2.new(0.267, 0, 0.829, 0),
		Position = UDim2.new(0.84, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = THEME.TogglePillColor or Color3.fromRGB(35, 35, 45),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Parent = bar,
	})
	local inputStroke = addPlainStroke(inputContain, THEME.ComponentStrokeThickness, THEME.ComponentStrokeColor)
	addGradient(inputContain, 0, THEME.TogglePillGradient)
	addCorner(inputContain, UDim.new(0, 8))

	local box = create("TextBox", {
		Name = "Box",
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Text = initialText,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = THEME.Font,
		TextSize = 15,
		ClearTextOnFocus = false,
		ZIndex = 5,
		Parent = inputContain,
	})

	if filterType then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if filterType == "int" then
				box.Text = box.Text:gsub("[^%d-]", "")
			elseif filterType == "float" then
				box.Text = box.Text:gsub("[^%d.-]", "")
			end
		end)
	end

	box.Focused:Connect(function()
		TweenService:Create(inputStroke, TWEEN_INFO, { Color = Color3.fromRGB(255, 255, 255) }):Play()
	end)
	box.FocusLost:Connect(function()
		TweenService:Create(inputStroke, TWEEN_INFO, { Color = THEME.ComponentStrokeColor }):Play()
	end)

	return container, box
end

function Tab:AddInputInt(text, valueId, default)
	local values = self.Window.Values
	if values[valueId] == nil then
		values[valueId] = default or 0
	end

	local container, box = self:_buildInputBase("InputInt_" .. tostring(valueId), text, tostring(values[valueId]), "int")

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then 
			values[valueId] = math.floor(n) 
		end
		box.Text = tostring(values[valueId])
	end)

	return container
end

