		Name = "SliderTrack",
		Size = UDim2.new(0.5, 0, 0.85, 0),
		Position = UDim2.new(0.97, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Color3.fromRGB(35, 35, 45),
		BorderSizePixel = 0,
		Parent = bar,
	})
	addCorner(sliderTrack, UDim.new(1, 0))
	addPlainStroke(sliderTrack, THEME.ComponentStrokeThickness, THEME.ComponentStrokeColor)

	local sliderFill = create("Frame", {
		Name = "SliderFill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = THEME.TogglePillColor or Color3.fromRGB(0, 170, 255),
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = sliderTrack,
	})
	addCorner(sliderFill, UDim.new(0, 100))
	addGradient(sliderFill, 0, THEME.WindowDarkGradient)
	sliderFill.Size = UDim2.new((values[valueId] - minValue) / (maxValue - minValue), 0, 1, 0)

	local valueLabel = newGradientText(sliderTrack, {
		Name = "ValueLabel",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = tostring(values[valueId]),
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 3,
	})

	local sliderButton = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = sliderTrack,
	})

	local dragging = false

	local function setSliderValue(rawVal, triggerUpdate)
		local steppedVal = math.floor((rawVal / step) + 0.5) * step
		local clampedVal = math.clamp(steppedVal, minValue, maxValue)

		values[valueId] = clampedVal
		valueLabel.Text = tostring(clampedVal)

		local percent = math.clamp((clampedVal - minValue) / (maxValue - minValue), 0, 1)
		TweenService:Create(sliderFill, TWEEN_INFO, { Size = UDim2.new(percent, 0, 1, 0) }):Play()

		if triggerUpdate and updateThread then
			if typeof(updateThread) == "function" then
				task.spawn(updateThread, clampedVal)
			elseif typeof(updateThread) == "thread" then
				task.spawn(updateThread)
			end
		end
	end

	local function updateSliderFromInput(input)
		local percent = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
		local calculatedValue = minValue + ((maxValue - minValue) * percent)
		setSliderValue(calculatedValue, true)
	end

	setSliderValue(values[valueId], false)

	sliderButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			sfxclick:Play()
			updateSliderFromInput(input)
		end
	end)

	sliderButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSliderFromInput(input)
		end
	end)

	return container
end

