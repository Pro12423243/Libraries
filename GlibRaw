local function create(className, props, children)
	local inst = Instance.new(className)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function addCorner(instance, radius)
	return create("UICorner", { CornerRadius = radius, Parent = instance })
end

local function addPlainStroke(instance, thickness, color)
	return create("UIStroke", {
		Thickness = thickness,
		Color = color,
		Parent = instance,
	})
end

local function addGradientStroke(instance, thickness, color, rotation, colorSeq)
	local stroke = create("UIStroke", {
		Thickness = thickness,
		Color = color,
		Parent = instance,
	})
	create("UIGradient", {
		Enabled = true,
		Rotation = rotation,
		Offset = Vector2.new(0, 0),
		Color = colorSeq,
		Transparency = THEME.ZeroTransparency,
		Parent = stroke,
	})
	return stroke
end

local function addGradient(instance, rotation, colorSeq)
	return create("UIGradient", {
		Enabled = true,
		Rotation = rotation,
		Offset = Vector2.new(0, 0),
		Color = colorSeq,
		Transparency = THEME.ZeroTransparency,
		Parent = instance,
	})
end

local function addShadow(instance, blurRadius, color, transparency, offset, spread, zindex)
	pcall(function()
		create("UIShadow", {
			Enabled = true,
			BlurRadius = blurRadius or UDim.new(0, 12),
			Color = color or Color3.fromRGB(0, 0, 0),
			Transparency = transparency or 0.5,
			Offset = offset or UDim2.new(0, 0, 0, 4),
			Spread = spread or UDim2.new(0, 0, 0, 0),
			ZIndex = zindex or 1,
			Parent = instance,
		})
	end)
end

local UserInputService = game:GetService("UserInputService")

local function makeDraggable(dragHandle, target)
	local dragging = false
	local dragStart, startPos

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging
			and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local function makeAutoScrollingFrame(scrollingFrame, listProps)
	scrollingFrame.ScrollBarThickness = 0
	scrollingFrame.ScrollBarImageTransparency = 1
	scrollingFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)

	local list = create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Padding = UDim.new(0, 2),
		Parent = scrollingFrame,
	})

	if listProps then
		for prop, value in pairs(listProps) do
			list[prop] = value
		end
	end

	return list
end


local function newComponentContainer(parent, name, height, layoutOrder)
	return create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = layoutOrder,
		Parent = parent,
	})
end

local function newDarkCard(parent, size, position, anchorPoint)
	local card = create("Frame", {
		Name = "Card",
		Size = size or UDim2.new(0.95, 0, 0.95, 0),
		Position = position or UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = anchorPoint or Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Parent = parent,
	})
	addGradient(card, 0, THEME.ComponentBgGradient)
	addPlainStroke(card, THEME.ComponentStrokeThickness, THEME.ComponentStrokeColor)
	addCorner(card, UDim.new(0, 8))
	return card
end

local function newGradientText(parent, props)
	props = props or {}
	local label = create("TextLabel", {
		Name = props.Name or "TextLabel",
		Size = props.Size or UDim2.new(1, 0, 1, 0),
		Position = props.Position or UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Text = props.Text or "Label",
		TextColor3 = THEME.TextColor,
		TextSize = props.TextSize or 17,
		Font = THEME.Font,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Center,
		TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center,
		Parent = parent,
	})
	addGradient(label, 26, THEME.ComponentTextGradient)
	return label
end

